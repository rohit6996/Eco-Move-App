# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ECO-MOVE NAGPUR — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your private keys before running.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 1. SUPABASE (Database, Realtime Sync, Auth & Tickets)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. N8N AI WORKFLOWS (SafarBot / AI Transit Mitra Webhook)
N8N_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/explain-route
N8N_TEST_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook-test/explain-route

# 3. OPENROUTESERVICE & OPENSTREETMAP ROUTING
ORS_API_KEY=your-openrouteservice-api-key
ORS_FOOT_ROUTING_URL=https://api.openrouteservice.org/v2/directions/foot-walking/geojson
OSRM_FOOT_ROUTING_URL=https://router.project-osrm.org/route/v1/foot
OSRM_DRIVING_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# 4. GEOCODING & PLACES SEARCH (Photon & Nominatim)
PHOTON_GEOCODING_URL=https://photon.komoot.io/api
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org/search

# 5. CHALO MOBILITY LIVE TRANSIT (Nagpur Live Bus Schedules & GPS)
CHALO_ROUTE_DETAILS_LIVE_API=https://chalo.com/app/api/scheduler_v4/v4/nagpur/routedetailslive
CHALO_LIVE_TELEMETRY_API=https://chalo.com/app/api/vasudha/track/route-live-info/nagpur

# 6. GOOGLE MAPS & PLACES API KEY
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# 7. CARTO VOYAGER MAPS API KEY
CARTO_API_KEY=your-carto-maps-api-key
